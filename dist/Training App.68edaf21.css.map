:root {
  --color-primary: #4a6fa5;
  --color-primary-rgb: 74, 111, 165;
  --color-primary-dark: #3a5a8c;
  --color-primary-light: #6385bd;
  --color-secondary: #45b69c;
  --color-secondary-rgb: 69, 182, 156;
  --color-secondary-dark: #389982;
  --color-secondary-light: #5ec9af;
  --color-danger: #e15554;
  --color-danger-dark: #d13f3e;
  --color-danger-light: #e96c6b;
  --color-warning: #e3b23c;
  --color-success: #4caf50;
  --color-background: #f8f9fa;
  --color-surface: #fff;
  --color-text: #212529;
  --color-text-secondary: #6c757d;
  --color-border: #dee2e6;
  --color-shadow: #0000001a;
  --color-exercise: var(--color-primary);
  --color-rest: var(--color-secondary);
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  --font-size-base: 16px;
  --font-size-small: 14px;
  --font-size-large: 18px;
  --font-size-xl: 24px;
  --font-size-xxl: 32px;
  --font-size-huge: clamp(3rem, 15vw, 7rem);
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --border-radius-sm: 4px;
  --border-radius-md: 8px;
  --border-radius-lg: 16px;
  --border-width: 1px;
  --transition-fast: .15s ease;
  --transition-normal: .3s ease;
  --shadow-sm: 0 1px 3px #0000001f;
  --shadow-md: 0 4px 6px #0000001f;
  --shadow-lg: 0 10px 15px #0000001f;
}

.dark-mode {
  --color-background: #121212;
  --color-surface: #1e1e1e;
  --color-text: #f8f9fa;
  --color-text-secondary: #adb5bd;
  --color-border: #343a40;
  --color-shadow: #0000004d;
  --color-primary: #5d84c3;
  --color-primary-rgb: 93, 132, 195;
  --color-primary-dark: #4a6fa5;
  --color-primary-light: #7596d1;
  --color-secondary: #53caae;
  --color-secondary-rgb: 83, 202, 174;
  --color-secondary-dark: #45b69c;
  --color-secondary-light: #68d4ba;
  --shadow-sm: 0 1px 3px #0000004d;
  --shadow-md: 0 4px 6px #0000004d;
  --shadow-lg: 0 10px 15px #0000004d;
}
