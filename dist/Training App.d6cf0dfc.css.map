#player-screen {
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xl);
  flex-direction: column;
  min-height: 70vh;
  display: flex;
}

.timer-display {
  text-align: center;
  width: 100%;
  max-width: 600px;
}

.phase-name {
  font-size: var(--font-size-xl);
  margin-bottom: var(--spacing-md);
  font-weight: 600;
}

.timer {
  font-size: var(--font-size-huge);
  margin-bottom: var(--spacing-lg);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-weight: 700;
  line-height: 1;
}

.progress-container {
  background-color: var(--color-border);
  border-radius: var(--border-radius-lg);
  width: 100%;
  height: 10px;
  margin-bottom: var(--spacing-md);
  overflow: hidden;
}

.progress-bar {
  background-color: var(--color-primary);
  width: 0;
  height: 100%;
  transition: width var(--transition-fast);
}

.set-counter {
  font-size: var(--font-size-large);
  margin-bottom: var(--spacing-lg);
  font-weight: 500;
}

.player-controls {
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  flex-wrap: wrap;
  justify-content: center;
  display: flex;
}

.player-controls .btn.control {
  border-radius: 50%;
  justify-content: center;
  align-items: center;
  min-width: 60px;
  height: 60px;
  padding: 0;
  display: flex;
}

.player-controls .btn.control.large {
  min-width: 80px;
  height: 80px;
}

.player-controls .icon {
  font-size: 24px;
}

.player-controls .btn.control.large .icon {
  font-size: 32px;
}

.player-settings {
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-lg);
  flex-wrap: wrap;
  justify-content: center;
  display: flex;
}

.volume-control {
  align-items: center;
  gap: var(--spacing-sm);
  flex-direction: column;
  display: flex;
}

#volume-slider {
  width: 150px;
  margin-top: var(--spacing-xs);
}

.workout-selection {
  margin-bottom: var(--spacing-lg);
}

.workout-actions {
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
  flex-wrap: wrap;
  display: flex;
}

.workout-preview {
  background-color: var(--color-surface);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
}

.workout-controls {
  justify-content: center;
  display: flex;
}

.preview-section {
  margin-bottom: var(--spacing-lg);
}

.preview-section-title {
  font-size: var(--font-size-large);
  margin-bottom: var(--spacing-sm);
  color: var(--color-text-secondary);
  font-weight: 600;
}

.preview-steps {
  list-style: none;
}

.preview-step {
  padding: var(--spacing-sm);
  border-radius: var(--border-radius-sm);
  margin-bottom: var(--spacing-xs);
  display: flex;
}

.preview-step.exercise {
  background-color: rgba(var(--color-primary-rgb), .1);
}

.preview-step.rest {
  background-color: rgba(var(--color-secondary-rgb), .1);
}

.preview-step-name {
  flex: 1;
  font-weight: 500;
}

.preview-step-duration {
  font-variant-numeric: tabular-nums;
}
/*# sourceMappingURL=Training App.d6cf0dfc.css.map */
